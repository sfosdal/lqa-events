<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sold-out status for the Ticketmaster venues, twice a day; a run
       missed while the Mac sleeps happens once at wake. Install:
         cp scripts/launchd/net.fosdal.lqa-soldout.plist ~/Library/LaunchAgents/
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.fosdal.lqa-soldout.plist
       Remove: launchctl bootout gui/$(id -u)/net.fosdal.lqa-soldout -->
  <key>Label</key><string>net.fosdal.lqa-soldout</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/sfosdal/Desktop/projects/lqa-events/repo/scripts/soldout-run.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>7</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/sfosdal/Library/Logs/lqa-soldout.launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/sfosdal/Library/Logs/lqa-soldout.launchd.log</string>
</dict>
</plist>
